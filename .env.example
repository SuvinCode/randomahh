# Server-only settings. Copy to .env (git-ignored) for `npm run dev`, and set the
# same names in Render's dashboard for deploys. Never import these from src/.

# Mistral API key for the AI god box (https://console.mistral.ai/). Optional:
# without it the god box still understands the built-in words (tornado, 3 asteroids,
# lightning on Bob, give Alice a rocket...).
MISTRAL_API_KEY=
# Any Mistral chat model with JSON-schema structured output, e.g. mistral-small-latest.
MISTRAL_MODEL=
